# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
target/
src-tauri/target/

# Core binaries (downloaded via scripts/fetch-cores.ps1 or scripts/fetch-cores.sh)
src-tauri/resources/cores/*
!src-tauri/resources/cores/.gitkeep

# Android generated project, Gradle artifacts & downloaded .so cores (regenerated via tauri android init + configure-android.mjs)
src-tauri/gen/android/
src-tauri/plugins/**/android/.tauri/
src-tauri/plugins/**/android/build/

# Environment & temporary
.env
.env.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS
.vscode/
.idea/
*.suo
*.user
Thumbs.db
[Dd]esktop.ini
.DS_Store
