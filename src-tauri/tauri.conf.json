{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "NovaProxy",
  "version": "0.0.1",
  "identifier": "com.novaproxy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovaProxy",
        "width": 1080,
        "height": 720,
        "minWidth": 850,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/cores/*"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English", "SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
